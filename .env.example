# Documentation only; values are read from process environment.
JAVA_HOME=C:\Program Files\Java\jdk-21.0.11
DB_URL=jdbc:mysql://127.0.0.1:3306/kma_idp?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
DB_USERNAME=kma_idp_app
DB_PASSWORD=replace-locally
BOOTSTRAP_PASSWORD=replace-with-at-least-14-characters
IDP_ISSUER=http://127.0.0.1:8080
APP_ENCRYPTION_KEY_B64=
SESSION_IDLE_SECONDS=1800
OUTBOX_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLED=true
SMTP_STARTTLS_REQUIRED=true
# MailHog local preset: run .\run-mailhog.ps1; profile local,mailhog supplies
# 127.0.0.1:1025, no-reply@kma.local, SMTP auth/TLS off and outbox on.
# Production requires SIGNING_KEYSTORE, SIGNING_PASSWORD, SIGNING_ALIAS,
# TLS_KEYSTORE, TLS_KEYSTORE_PASSWORD and a 256-bit encryption key.

WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8080
